# ARIA backend configuration. Copy to .env and adjust. Never commit real secrets.

# Network binding
ARIA_HOST=0.0.0.0
ARIA_PORT=8000
ARIA_LOG_LEVEL=info

# Local storage
ARIA_DB_PATH=./aria.db

# Local services (offline-first defaults)
ARIA_OLLAMA_URL=http://localhost:11434
ARIA_WHISPER_MODEL=base

# Security: keep false to accept only loopback clients
ARIA_ALLOW_REMOTE=false
